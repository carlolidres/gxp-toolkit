# GxP Toolkit — environment variable template (committed reference)
#
# Copy to .env.local for local development:
#   cp .env.example .env.local        (Unix/macOS)
#   copy .env.example .env.local      (Windows PowerShell / CMD)
#
# Only VITE_* variables are inlined into the client bundle at build time.
# Never put real secrets in this file — use placeholders only.
# Real Supabase URL and anon key belong in .env.local (gitignored).

# Supabase (optional until @supabase/supabase-js is integrated)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application environment label (development | staging | production)
VITE_APP_ENV=development

# GitHub Pages subpath when repo is not at domain root (e.g. /gxp-toolkit/)
# For local dev you can comment this out (or set VITE_BASE_PATH=./) so the app is at http://localhost:5173/#/login
VITE_BASE_PATH=/gxp-toolkit/
# VITE_GITHUB_PAGES=true

# Edge Function secret (set in Supabase Dashboard — not a VITE_ browser variable):
# EDOC_VERIFY_PUBLIC_BASE_URL=https://carlolidres.github.io/gxp-toolkit/
# Used when stamping signature verify links / QR codes into finalized PDFs.

# Playwright eDoc staging smoke (disposable @example.test accounts — never commit passwords)
# E2E_EDOC_TEST_PASSWORD=
# E2E_EDOC_REVIEWER_EMAIL=edoc-reviewer@example.test
# E2E_EDOC_CREATOR_EMAIL=edoc-creator@example.test

# eDoc billing (Paddle + optional PayMongo) — flags default OFF.
# Never put PADDLE_API_KEY, PAYMONGO_SECRET_KEY_*, or webhook secrets in VITE_*.
# Those belong in Supabase Edge Function secrets only.
# Checkout Edge Function also requires Edge secrets BILLING_ENABLED=true and PADDLE_CHECKOUT_ENABLED=true
# (separate from these VITE_* flags). Leave both off until owner enables sandbox charges.
# Document/seat quotas are enforced in Postgres only. Default off until:
#   UPDATE edoc_billing_runtime SET billing_enabled = true, free_plan_limits_enabled = true,
#     paddle_checkout_enabled = true WHERE id = 'default';
VITE_BILLING_ENABLED=false
VITE_PADDLE_CHECKOUT_ENABLED=false
VITE_ENABLE_PAYMONGO=false
VITE_PAYMONGO_CHECKOUT_ENABLED=false

# CPV (Continuous Process Verification). Production default off (C15).
# Local `npm run dev` shows CPV unless this is set to false. Set true for production builds.
VITE_ENABLE_CPV=false
VITE_ANNUAL_BILLING_ENABLED=false
VITE_BUSINESS_PLAN_ENABLED=false
VITE_FREE_PLAN_LIMITS_ENABLED=false
VITE_BILLING_PORTAL_ENABLED=false
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# Live Paddle must use a SEPARATE Supabase project (C10). Never set VITE_PADDLE_ENV=production
# on staging ydndeoacgfnxjqwwnswh. Owner checklist: plans/edoc-international-subscription/go-live-checklist.md

# Edge Function secrets (Supabase Dashboard — not VITE_ / not git):
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# BILLING_PORTAL_ENABLED=false
# BILLING_RECONCILE_ENABLED=false
# BILLING_RECONCILE_SECRET=   (GitHub Actions: EDOC_BILLING_RECONCILE_SECRET; never VITE_*)
# PayMongo (Philippines). Default off. GoTyme is PayMongo settlement only — not a checkout provider.
# ENABLE_PAYMONGO=false
# PAYMONGO_CHECKOUT_ENABLED=false
# PAYMONGO_ENV=test
# PAYMONGO_SECRET_KEY_TEST=
# PAYMONGO_WEBHOOK_SECRET_TEST=
# PAYMONGO_SECRET_KEY_LIVE=
# PAYMONGO_WEBHOOK_SECRET_LIVE=
# PAYMONGO_PILOT_EMAILS=   (optional comma-separated allowlist)
# PAYMONGO_PLAN_PERSONAL_MONTHLY=
# PAYMONGO_PLAN_PERSONAL_ANNUAL=
# PAYMONGO_PLAN_PRO_MONTHLY=
# PAYMONGO_PLAN_PRO_ANNUAL=
# PAYMONGO_PLAN_BUSINESS_MONTHLY=
# PAYMONGO_PLAN_BUSINESS_ANNUAL=
# Webhook URL (verify_jwt=false; signature on raw body):
#   https://<project>.supabase.co/functions/v1/edoc-paymongo-webhook
# Sandbox catalog price IDs (not secrets; also in database/sqlite/edoc_seed.sql):
# PADDLE_PRICE_PERSONAL_MONTHLY=pri_01m09kd9fw8tpbeyrcnsrzy4ea
# PADDLE_PRICE_PERSONAL_ANNUAL=pri_01m09kem1734t13qt18y2xn75x
# PADDLE_PRICE_PRO_MONTHLY=pri_01m09kvd9rxggqb1jf49aknn4k
# PADDLE_PRICE_PRO_ANNUAL=pri_01m09kwn51w0ej0ptxstf5jwxx
# PADDLE_PRICE_BUSINESS_MONTHLY=pri_01m09m0pt9rmyp7fweexttyd4b
# PADDLE_PRICE_BUSINESS_ANNUAL=pri_01m09m1t2zg6t1pp8ppnwa1858

# Provisioning script only (local shell — never commit)
# SUPABASE_SERVICE_ROLE_KEY=
# STAGING_EDOC_TEST_PASSWORD=
